PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_pager
JWT_SECRET=change-me-to-a-long-random-string
# Public base URL customers reach (used inside QR codes). Dev: the Vite URL.
PUBLIC_URL=http://localhost:5173
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Delete push subscriptions of finished orders after this many hours
RETENTION_HOURS=24
